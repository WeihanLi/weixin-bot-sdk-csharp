<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyTitle>Weixin Bot SDK</AssemblyTitle>
    <Version>0.1.0</Version>
    <PackageId>Weixin.Bot.Sdk</PackageId>
    <Authors>Weixin Bot SDK Contributors</Authors>
    <Description>Modern .NET SDK for the WeChat iLink Bot protocol.</Description>
    <RepositoryUrl>https://github.com/WeihanLi/weixin-bot-sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>weixin;wechat;bot;sdk;ilink</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
